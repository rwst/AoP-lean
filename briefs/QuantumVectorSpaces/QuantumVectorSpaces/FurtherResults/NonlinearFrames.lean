module

public import QuantumVectorSpaces.FurtherResults.LinearFrames
public import ForMathlib.Analysis.Distribution.SchwartzSpace.CompDiffeo

/-!
# Further results: nonlinear changes of frame of `𝓢(ℝⁿ)`

Not part of the brief. This file extends Sec. 3 of `further-results.tex` in the brief's
directory from the linear changes of frame (`LinearFrames.lean`) to nonlinear ones.

A change of coordinates `y = e(x)` of `ℝⁿ` acts on wave functions by the unitary
`U_e f = |det De|^{1/2} (f ∘ e)` of `L²(ℝⁿ)`. If `e` and `e⁻¹` both have temperate growth, `U_e` is
an automorphism of `𝓢(ℝⁿ)` that preserves the inner product (`SchwartzMap.compDiffeoCLE`). So the
point transformations, the `U_e` together with the gauge phases `e^{iφ}` for real `φ` of temperate
growth, form a frame group with [B]WDQ for Example 3. The condition is sufficient, not necessary.
The change of frame `y = tan(π/2 · erf x)` of problem 6 fails it: `e` grows like `e^{x²}` and `e⁻¹`
only like `√(log |y|)`, and that change of frame does not preserve `𝓢(ℝ)`
(`not_forall_frameUnitary_mem_range`).

## Main definitions

* `diffeoFrame e he he'`: the change of frame `U_e`;
* `pointFrames n`: the group generated by the `U_e` and the phases;
* `shear v φ hφ`: the bijection `x ↦ x + φ(x) v` for `φ` constant along `v`, a nonlinear example.

## Main results

* `diffeoFrame_mem`: `U_e` is a unitary automorphism of `𝓢(ℝⁿ)`;
* `pointFrames_le_schwartzAut`, `isFrameCompatible_pointFrames`: the point transformations satisfy
  [B]WDQ;
* `isFrameCompatible_linearFrames_sup_pointFrames`: so do the point transformations and the linear
  changes of frame together.
-/

open SchwartzMap MeasureTheory Complex ComplexConjugate

@[expose] public noncomputable section

namespace QuantumVectorSpaces.FurtherResults

variable {n : ℕ}

set_option hygiene false in
local notation "𝓢ₙ" => 𝓢(EuclideanSpace ℝ (Fin n), ℂ)

set_option hygiene false in
local notation "Eₙ" => EuclideanSpace ℝ (Fin n)

/-- The change of frame `f ↦ |det De|^{1/2} (f ∘ e)` along a bijection `e` of `ℝⁿ` such that `e` and
`e⁻¹` have temperate growth. -/
def diffeoFrame (e : Eₙ ≃ Eₙ) (he : (e : Eₙ → Eₙ).HasTemperateGrowth)
    (he' : (e.symm : Eₙ → Eₙ).HasTemperateGrowth) : 𝓢ₙ ≃L[ℂ] 𝓢ₙ :=
  compDiffeoCLE ℂ ℂ e he he'

lemma diffeoFrame_apply (e : Eₙ ≃ Eₙ) (he : (e : Eₙ → Eₙ).HasTemperateGrowth)
    (he' : (e.symm : Eₙ → Eₙ).HasTemperateGrowth) (f : 𝓢ₙ) (x : Eₙ) :
    diffeoFrame e he he' f x = jacobianWeight e x * f (e x) :=
  compDiffeoCLE_apply he he' f x

/-- **Nonlinear changes of frame.** `U_e` is an automorphism of `𝓢(ℝⁿ)` that preserves the inner
product. -/
theorem diffeoFrame_mem (e : Eₙ ≃ Eₙ) (he : (e : Eₙ → Eₙ).HasTemperateGrowth)
    (he' : (e.symm : Eₙ → Eₙ).HasTemperateGrowth) :
    (diffeoFrame e he he').toLinearEquiv ∈ schwartzAut n :=
  mem_schwartzAut _ fun f g => by
    simpa [diffeoFrame, RCLike.inner_apply, mul_comm] using
      integral_inner_compDiffeoCLE (𝕜 := ℂ) volume he he' f g

variable (n) in
/-- The point transformations of `𝓢(ℝⁿ)`: the group generated by the changes of frame `U_e`, for
`e` and `e⁻¹` of temperate growth, and the phases `e^{iφ}`, for real `φ` of temperate growth. -/
def pointFrames : Subgroup (𝓢ₙ ≃ₗ[ℂ] 𝓢ₙ) :=
  Subgroup.closure <|
    {U | ∃ (e : Eₙ ≃ Eₙ) (he : (e : Eₙ → Eₙ).HasTemperateGrowth)
      (he' : (e.symm : Eₙ → Eₙ).HasTemperateGrowth), U = (diffeoFrame e he he').toLinearEquiv} ∪
    {U | ∃ (φ : Eₙ → ℝ) (hφ : φ.HasTemperateGrowth), U = (phase hφ).toLinearEquiv}

theorem pointFrames_le_schwartzAut : pointFrames n ≤ schwartzAut n := by
  refine (Subgroup.closure_le _).2 ?_
  rintro _ (⟨e, he, he', rfl⟩ | ⟨φ, hφ, rfl⟩)
  · exact diffeoFrame_mem e he he'
  · exact phase_mem hφ

/-- **The point transformations of Example 3 satisfy [B]WDQ.** -/
theorem isFrameCompatible_pointFrames {ħ : ℝ} (hħ : ħ ≠ 0) :
    IsFrameCompatible (l2CoreN n) (obsN n ħ)
      (FrameGroup.ofSubgroup (pointFrames n) fun _ he => (pointFrames_le_schwartzAut he).1) :=
  (isFrameCompatible_schwartzN hħ _ _).2 pointFrames_le_schwartzAut

/-- **Linear and nonlinear changes of frame together satisfy [B]WDQ.** -/
theorem isFrameCompatible_linearFrames_sup_pointFrames {ħ : ℝ} (hħ : ħ ≠ 0) :
    IsFrameCompatible (l2CoreN n) (obsN n ħ)
      (FrameGroup.ofSubgroup (linearFrames n ⊔ pointFrames n) fun _ he =>
        (sup_le linearFrames_le_schwartzAut pointFrames_le_schwartzAut he).1) :=
  (isFrameCompatible_schwartzN hħ _ _).2 (sup_le linearFrames_le_schwartzAut
    pointFrames_le_schwartzAut)

/-! ### A nonlinear example -/

/-- The shear `x ↦ x + φ(x) v`, for `φ` constant along `v`; its inverse is `x ↦ x - φ(x) v`. For
`n = 2`, `v = e₂` and `φ(x) = x₁²` this is `(x₁, x₂) ↦ (x₁, x₂ + x₁²)`. -/
def shear (v : Eₙ) (φ : Eₙ → ℝ) (hφ : ∀ x (t : ℝ), φ (x + t • v) = φ x) : Eₙ ≃ Eₙ where
  toFun x := x + φ x • v
  invFun x := x - φ x • v
  left_inv x := by simp [hφ]
  right_inv x := by
    have := hφ x (-φ x)
    simp only [neg_smul, ← sub_eq_add_neg] at this
    simp [this]

lemma hasTemperateGrowth_shear (v : Eₙ) {φ : Eₙ → ℝ} (hφ : ∀ x (t : ℝ), φ (x + t • v) = φ x)
    (hφ' : φ.HasTemperateGrowth) : ((shear v φ hφ : Eₙ ≃ Eₙ) : Eₙ → Eₙ).HasTemperateGrowth :=
  Function.HasTemperateGrowth.id'.add (hφ'.smul (.const v))

lemma hasTemperateGrowth_shear_symm (v : Eₙ) {φ : Eₙ → ℝ}
    (hφ : ∀ x (t : ℝ), φ (x + t • v) = φ x) (hφ' : φ.HasTemperateGrowth) :
    ((shear v φ hφ).symm : Eₙ → Eₙ).HasTemperateGrowth :=
  Function.HasTemperateGrowth.id'.sub (hφ'.smul (.const v))

/-- The shears are nonlinear changes of frame with [B]WDQ. -/
theorem shear_mem_pointFrames (v : Eₙ) {φ : Eₙ → ℝ} (hφ : ∀ x (t : ℝ), φ (x + t • v) = φ x)
    (hφ' : φ.HasTemperateGrowth) :
    (diffeoFrame (shear v φ hφ) (hasTemperateGrowth_shear v hφ hφ')
      (hasTemperateGrowth_shear_symm v hφ hφ')).toLinearEquiv ∈ pointFrames n :=
  Subgroup.subset_closure (Or.inl ⟨_, _, _, rfl⟩)

end QuantumVectorSpaces.FurtherResults
