module

/-
Physical vector spaces for quantum mechanics.
Technical brief by G. Carcassi for the Assumptions of Physics collaboration,
https://assumptionsofphysics.org/resources/briefs

Setting: a complex vector space `V` with an inner product `c` (a `PreInnerProductSpace.Core`, which
puts no topology on `V`) and a family `X i` of defining observables (linear maps `V → V`).

Corollary 2:
* `algebra`          the unital algebra generated by the defining observables;
* `seminormFamily`   the seminorms `v ↦ √⟨Av, Av⟩` for `A` in that algebra;
* `topology`         the topology they generate;
* `IsAdmissible`     a vector-space topology making the `X i` and the inner product continuous;
* `isGreatest_topology`  `topology` is the coarsest admissible topology;
* `locallyConvexSpace`   so `V` is locally convex;
* `topology_eq_moduleTopology`  in finite dimension it is the usual topology.

Example 3 (`𝓢(ℝ)` with `X`, `P`, `I`, for `ħ ≠ 0`; the brief has `𝓢(ℝⁿ)`):
* `posOp_mul_momOp_sub`  `[X, P] = iħ`;
* `isSymmetric_obs`      `X`, `P`, `I` are symmetric for the `L²` inner product;
* `algebra_le_monoSpan`  every element of the algebra is a combination of the `X^a P^b`;
* `topology_schwartz`    the topology of Corollary 2 is the Schwartz topology (via the `L²`
  seminorms of `SchwartzNorms`);
* `isAdmissible_schwartz`.

Example 4 (qubit):
* `spin_comm`           `[Sᵢ, Sᵢ₊₁] = iħ Sᵢ₊₂` for `Sᵢ = (ħ/2) σᵢ`;
* `isSymmetric_spin`, `topology_qubit`  the topology of Corollary 2 is the usual one on `ℂ²`.

Theorem 5, [B]COBS:
* `IsAdmissible.continuous_expectation`  expectations `⟨v, Av⟩` are continuous.
-/
public import ForMathlib.Analysis.CStarAlgebra.Matrix
public import ForMathlib.Analysis.InnerProductSpace.Defs
public import Mathlib.Analysis.Distribution.SchwartzSpace.Deriv
public import Mathlib.Analysis.Matrix.Hermitian
public import SchwartzNorms

open Topology

@[expose] public noncomputable section

namespace QuantumVectorSpaces

/-! ### Corollary 2: the topology of a quantum vector space -/

section Corollary2

variable {V : Type*} [AddCommGroup V] [Module ℂ V] (c : PreInnerProductSpace.Core ℂ V)
  {ι : Type*} (X : ι → Module.End ℂ V)

/-- The unital algebra generated by the defining observables. -/
abbrev algebra : Subalgebra ℂ (Module.End ℂ V) := Algebra.adjoin ℂ (Set.range X)

/-- The seminorms `p_A v = √⟨Av, Av⟩`, for `A` in the unital algebra of the observables. -/
def seminormFamily : SeminormFamily ℂ V (algebra X) := fun A => c.toSeminorm.comp A.1

/-- The topology generated by the seminorms `p_A`. -/
@[instance_reducible]
def topology : TopologicalSpace V := (seminormFamily c X).moduleFilterBasis.topology

/-- A topology on `V` is admissible if it is a vector-space topology that makes the defining
observables and the inner product continuous. -/
structure IsAdmissible (t : TopologicalSpace V) : Prop where
  isTopologicalAddGroup : IsTopologicalAddGroup V
  continuousSMul : ContinuousSMul ℂ V
  continuous_obs (i : ι) : Continuous (X i)
  continuous_inner : Continuous fun p : V × V => c.inner p.1 p.2

/-- An everywhere-defined operator is symmetric (equivalently, self-adjoint) for the inner
product `c`. -/
def IsSymmetric (A : Module.End ℂ V) : Prop := ∀ v w, c.inner (A v) w = c.inner v (A w)

theorem withSeminorms : letI := topology c X; WithSeminorms (seminormFamily c X) :=
  letI := topology c X; ⟨rfl⟩

lemma seminormFamily_mul (A B : algebra X) :
    (seminormFamily c X A).comp B.1 = seminormFamily c X (A * B) := by
  simp [seminormFamily, Seminorm.comp_comp, Module.End.mul_eq_comp]

lemma seminormFamily_one : seminormFamily c X 1 = c.toSeminorm := by
  ext v
  simp [seminormFamily]

/-- The seminorm topology is admissible. -/
theorem isAdmissible_topology : IsAdmissible c X (topology c X) := by
  let := topology c X
  have hp : WithSeminorms (seminormFamily c X) := withSeminorms c X
  refine ⟨hp.isTopologicalAddGroup, hp.continuousSMul, fun i => ?_, ?_⟩
  · have hXi : X i ∈ algebra X := Algebra.subset_adjoin ⟨i, rfl⟩
    refine WithSeminorms.continuous_of_continuous_comp hp (X i) fun A => ?_
    rw [show X i = (⟨X i, hXi⟩ : algebra X).1 from rfl, seminormFamily_mul]
    exact hp.continuous_seminorm _
  · have := hp.isTopologicalAddGroup
    refine c.continuous_inner ?_
    rw [← seminormFamily_one c X]
    exact hp.continuous_seminorm _

/-- In an admissible topology, every element of the algebra of observables is continuous. -/
theorem IsAdmissible.continuous_algebra {t : TopologicalSpace V} (ht : IsAdmissible c X t)
    (A : algebra X) : Continuous A.1 := by
  have := ht.isTopologicalAddGroup
  have := ht.continuousSMul
  obtain ⟨A, hA⟩ := A
  induction hA using Algebra.adjoin_induction with
  | mem A hA =>
    obtain ⟨i, rfl⟩ := hA
    exact ht.continuous_obs i
  | algebraMap r =>
    simp only [Module.algebraMap_end_eq_smul_id]
    exact continuous_const_smul r
  | add A B _ _ hA hB =>
    simp only [LinearMap.coe_add]
    exact hA.add hB
  | mul A B _ _ hA hB =>
    simp only [Module.End.mul_eq_comp, LinearMap.coe_comp]
    exact hA.comp hB

/-- Theorem 5, [B]COBS: in an admissible topology, the expectation `v ↦ ⟨v, Av⟩` of every element
of the algebra of observables is continuous. -/
theorem IsAdmissible.continuous_expectation {t : TopologicalSpace V} (ht : IsAdmissible c X t)
    (A : algebra X) : Continuous fun v => c.inner v (A.1 v) :=
  ht.continuous_inner.comp (continuous_id.prodMk (ht.continuous_algebra c X A))

/-- Corollary 2: the seminorm topology is the coarsest admissible topology. (In Mathlib's
order on topologies, coarser is larger.) -/
theorem isGreatest_topology : IsGreatest {t | IsAdmissible c X t} (topology c X) := by
  refine ⟨isAdmissible_topology c X, fun t ht => ?_⟩
  rw [← continuous_id_iff_le]
  have := ht.isTopologicalAddGroup
  refine @WithSeminorms.continuous_of_continuous_comp ℂ ℂ V V _ _ _ _ _ _ _ _ _ _ t _
    (topology c X) (withSeminorms c X) LinearMap.id fun A => ?_
  have h1 := c.continuous_toSeminorm ht.continuous_inner
  exact h1.comp (ht.continuous_algebra c X A)

/-- Corollary 2, second part: with this topology, `V` is locally convex. -/
theorem locallyConvexSpace : letI := topology c X; LocallyConvexSpace ℝ V :=
  letI := topology c X; (withSeminorms c X).toLocallyConvexSpace

/-- In finite dimension, for a definite inner product, the topology of Corollary 2 is the
unique Hausdorff vector-space topology, whatever the defining observables. -/
theorem topology_eq_moduleTopology [FiniteDimensional ℂ V]
    (hc : ∀ v, c.inner v v = 0 → v = 0) : topology c X = moduleTopology ℂ V := by
  let := topology c X
  have hp : WithSeminorms (seminormFamily c X) := withSeminorms c X
  have := hp.isTopologicalAddGroup
  have := hp.continuousSMul
  have : T1Space V := hp.T1_of_separating fun v hv => ⟨1, by
    let : PreInnerProductSpace.Core ℂ V := c
    have h0 : RCLike.re (c.inner v v) ≠ 0 := fun h => hv (hc v (by
      rw [← InnerProductSpace.Core.inner_self_ofReal_re (𝕜 := ℂ) v]
      change ((RCLike.re (c.inner v v) : ℝ) : ℂ) = 0
      rw [h]
      simp))
    have hpos : 0 < RCLike.re (c.inner v v) :=
      lt_of_le_of_ne (InnerProductSpace.Core.inner_self_nonneg (𝕜 := ℂ)) (Ne.symm h0)
    rw [seminormFamily_one, PreInnerProductSpace.Core.toSeminorm_apply]
    exact (Real.sqrt_pos.mpr hpos).ne'⟩
  have := isModuleTopologyOfFiniteDimensional (𝕜 := ℂ) (E := V)
  exact eq_moduleTopology ℂ V

end Corollary2

/-! ### Example 3: the Schwartz space `𝓢(ℝ)` -/

section Schwartz

open SchwartzMap MeasureTheory SchwartzNorms Complex ComplexConjugate
open scoped NNReal

/-- The `L²` inner product `⟨f, g⟩ = ∫ conj(f) g` on `𝓢(ℝ)`. -/
@[instance_reducible]
def l2Core : PreInnerProductSpace.Core ℂ 𝓢(ℝ, ℂ) where
  inner f g := inner ℂ (f.toLp 2) (g.toLp 2)
  conj_inner_symm f g := inner_conj_symm _ _
  re_inner_nonneg f := inner_self_nonneg (𝕜 := ℂ) (x := f.toLp 2)
  add_left f g h := by
    rw [← toLpCLM_apply (𝕜 := ℂ), map_add, inner_add_left]
    rfl
  smul_left f g r := by
    rw [← toLpCLM_apply (𝕜 := ℂ), map_smul, inner_smul_left]
    rfl

lemma l2Core_toSeminorm (f : 𝓢(ℝ, ℂ)) :
    l2Core.toSeminorm f = (eLpNorm f 2 volume).toReal := by
  rw [PreInnerProductSpace.Core.toSeminorm_apply, ← norm_toLp]
  exact (norm_eq_sqrt_re_inner (𝕜 := ℂ) (f.toLp 2 (volume : Measure ℝ))).symm

/-- The position operator `X f = x f`. -/
def posOp : Module.End ℂ 𝓢(ℝ, ℂ) := (smulLeftCLM ℂ Complex.ofReal).toLinearMap

/-- The momentum operator `P f = -iħ f'`. -/
def momOp (ħ : ℝ) : Module.End ℂ 𝓢(ℝ, ℂ) := (-I * ħ) • (derivCLM ℂ ℂ).toLinearMap

/-- The defining observables `X, P, I` of Example 3. -/
def obs (ħ : ℝ) : Fin 3 → Module.End ℂ 𝓢(ℝ, ℂ) := ![posOp, momOp ħ, 1]

variable (ħ : ℝ)

lemma posOp_apply (f : 𝓢(ℝ, ℂ)) (x : ℝ) : posOp f x = x * f x :=
  smulLeftCLM_apply_apply hasTemperateGrowth_ofReal f x

lemma momOp_apply (f : 𝓢(ℝ, ℂ)) (x : ℝ) : momOp ħ f x = -I * ħ * deriv f x := by
  simp [momOp]

lemma posOp_pow_apply (n : ℕ) (f : 𝓢(ℝ, ℂ)) (x : ℝ) :
    (posOp ^ n) f x = (x : ℂ) ^ n * f x := by
  induction n generalizing f with
  | zero => simp
  | succ n ih => rw [pow_succ, Module.End.mul_apply, ih, posOp_apply, pow_succ]; ring

lemma momOp_pow_apply (n : ℕ) (f : 𝓢(ℝ, ℂ)) (x : ℝ) :
    (momOp ħ ^ n) f x = (-I * ħ) ^ n * iteratedDeriv n f x := by
  induction n generalizing x with
  | zero => simp
  | succ n ih =>
    have h : ⇑((momOp ħ ^ n) f) = fun y => (-I * ħ) ^ n * iteratedDeriv n f y := funext ih
    rw [pow_succ', Module.End.mul_apply, momOp_apply, h, deriv_const_mul_field',
      iteratedDeriv_succ, pow_succ']
    ring

/-- The canonical commutation relation `[X, P] = iħ`. -/
theorem posOp_mul_momOp_sub :
    posOp * momOp ħ - momOp ħ * posOp = (I * ħ) • (1 : Module.End ℂ 𝓢(ℝ, ℂ)) := by
  ext f x
  have hd : HasDerivAt (fun y : ℝ => (y : ℂ) * f y) (1 * f x + x * deriv f x) x :=
    (hasDerivAt_id x).ofReal_comp.mul (f.hasDerivAt x)
  have he : ⇑(posOp f) = fun y : ℝ => (y : ℂ) * f y := funext (posOp_apply f)
  simp only [LinearMap.sub_apply, Module.End.mul_apply, posOp_apply, momOp_apply, he, hd.deriv,
    LinearMap.smul_apply, Module.End.one_apply, sub_apply, smul_apply,
    smul_eq_mul]
  ring

lemma l2Core_inner (f g : 𝓢(ℝ, ℂ)) : l2Core.inner f g = ∫ x, conj (f x) * g x := by
  change inner ℂ (f.toLp 2) (g.toLp 2) = _
  rw [L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards [f.coeFn_toLp 2, g.coeFn_toLp 2] with x hf hg
  rw [hf, hg, RCLike.inner_apply, mul_comm]

lemma isSymmetric_posOp : IsSymmetric l2Core posOp := fun f g => by
  simp only [l2Core_inner, posOp_apply, map_mul, conj_ofReal]
  congr 1
  funext x
  ring

lemma isSymmetric_momOp : IsSymmetric l2Core (momOp ħ) := fun f g => by
  let L : ℂ →L[ℝ] ℂ →L[ℝ] ℂ :=
    (ContinuousLinearMap.mul ℝ ℂ).comp Complex.conjCLE.toContinuousLinearMap
  have hL : ∀ u v, L u v = conj u * v := fun _ _ => by simp [L]
  have hibp := integral_bilinear_deriv_right_eq_neg_left f g L
  simp only [hL] at hibp
  simp only [l2Core_inner, momOp_apply, map_mul, map_neg, conj_I, conj_ofReal]
  have h1 : (fun x => -(-I) * (ħ : ℂ) * conj (deriv (⇑f) x) * g x) =
      fun x => (I * ħ) * (conj (deriv (⇑f) x) * g x) := by funext x; ring
  have h2 : (fun x => conj (f x) * (-I * ħ * deriv (⇑g) x)) =
      fun x => (-I * ħ) * (conj (f x) * deriv (⇑g) x) := by funext x; ring
  rw [h1, h2, integral_const_mul, integral_const_mul, hibp]
  ring

/-- Example 3: the defining observables `X, P, I` are symmetric for the `L²` inner product. -/
theorem isSymmetric_obs (i : Fin 3) : IsSymmetric l2Core (obs ħ i) := by
  fin_cases i
  · exact isSymmetric_posOp
  · exact isSymmetric_momOp ħ
  · exact fun f g => rfl

/-- `P X^{n+1} = X^{n+1} P - (n+1) iħ X^n`, from the commutation relation. -/
lemma momOp_mul_posOp_pow_succ (n : ℕ) :
    momOp ħ * posOp ^ (n + 1) =
      posOp ^ (n + 1) * momOp ħ - ((n + 1 : ℂ) * (I * ħ)) • posOp ^ n := by
  have hc := posOp_mul_momOp_sub ħ
  have h1 : momOp ħ * posOp = posOp * momOp ħ - (I * ħ) • 1 := by rw [← hc]; abel
  induction n with
  | zero => simpa using h1
  | succ n ih =>
    rw [pow_succ posOp (n + 1), ← mul_assoc, ih, sub_mul, mul_assoc, h1, mul_sub, ← mul_assoc,
      ← pow_succ, smul_mul_assoc, ← pow_succ, mul_smul_comm, mul_one]
    push_cast
    rw [sub_sub, ← add_smul]
    ring_nf

/-- The normally ordered monomials `X^a P^b`. -/
def mono (a b : ℕ) : Module.End ℂ 𝓢(ℝ, ℂ) := posOp ^ a * momOp ħ ^ b

/-- The span of the normally ordered monomials. -/
def monoSpan : Submodule ℂ (Module.End ℂ 𝓢(ℝ, ℂ)) :=
  Submodule.span ℂ (Set.range fun ab : ℕ × ℕ => mono ħ ab.1 ab.2)

lemma mono_mem (a b : ℕ) : mono ħ a b ∈ monoSpan ħ := Submodule.subset_span ⟨(a, b), rfl⟩

lemma mul_mem_monoSpan {g : Module.End ℂ 𝓢(ℝ, ℂ)} (hg : ∀ a b, g * mono ħ a b ∈ monoSpan ħ)
    {A : Module.End ℂ 𝓢(ℝ, ℂ)} (hA : A ∈ monoSpan ħ) : g * A ∈ monoSpan ħ := by
  induction hA using Submodule.span_induction with
  | mem x hx => obtain ⟨⟨a, b⟩, rfl⟩ := hx; exact hg a b
  | zero => simp
  | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
  | smul r x _ hx => rw [mul_smul_comm]; exact Submodule.smul_mem _ r hx

lemma posOp_mul_mono (a b : ℕ) : posOp * mono ħ a b ∈ monoSpan ħ := by
  rw [mono, ← mul_assoc, ← pow_succ']
  exact mono_mem ħ _ _

lemma momOp_mul_mono (a b : ℕ) : momOp ħ * mono ħ a b ∈ monoSpan ħ := by
  cases a with
  | zero =>
    rw [mono, pow_zero, one_mul, ← pow_succ']
    simpa [mono] using mono_mem ħ 0 (b + 1)
  | succ a =>
    rw [mono, ← mul_assoc, momOp_mul_posOp_pow_succ, sub_mul, smul_mul_assoc, mul_assoc,
      ← pow_succ']
    exact sub_mem (mono_mem ħ _ _) (Submodule.smul_mem _ _ (mono_mem ħ _ _))

/-- Every element of the algebra generated by `X, P, I` is a linear combination of normally
ordered monomials `X^a P^b`. -/
lemma algebra_le_monoSpan : Subalgebra.toSubmodule (algebra (obs ħ)) ≤ monoSpan ħ := by
  rw [Algebra.adjoin_eq_span, Submodule.span_le]
  intro A hA
  induction hA using Submonoid.closure_induction_left with
  | one => simpa [mono] using mono_mem ħ 0 0
  | mul_left x hx y _ hy =>
    obtain ⟨i, rfl⟩ := hx
    fin_cases i
    · exact mul_mem_monoSpan ħ (posOp_mul_mono ħ) hy
    · exact mul_mem_monoSpan ħ (momOp_mul_mono ħ) hy
    · simpa [obs] using hy

lemma mono_mem_algebra (a b : ℕ) : mono ħ a b ∈ algebra (obs ħ) :=
  mul_mem (pow_mem (Algebra.subset_adjoin (⟨0, rfl⟩ : posOp ∈ Set.range (obs ħ))) a)
    (pow_mem (Algebra.subset_adjoin (⟨1, rfl⟩ : momOp ħ ∈ Set.range (obs ħ))) b)

lemma mono_apply (a b : ℕ) (f : 𝓢(ℝ, ℂ)) :
    ⇑(mono ħ a b f) = (-I * ħ) ^ b • weighted a b f := by
  funext x
  simp only [mono, Module.End.mul_apply, posOp_pow_apply, momOp_pow_apply, weighted,
    Pi.smul_apply, smul_eq_mul]
  ring

/-- `‖X^a P^b f‖ = |ħ|^b ‖f‖^{L²}_{a,b}`. -/
lemma toSeminorm_comp_mono (a b : ℕ) :
    l2Core.toSeminorm.comp (mono ħ a b) = (‖ħ‖₊ ^ b) • l2Family (a, b) := by
  ext f
  rw [Seminorm.comp_apply, l2Core_toSeminorm, mono_apply, eLpNorm_const_smul, ENNReal.toReal_mul,
    _root_.smul_apply, NNReal.smul_def]
  have h : ‖(-I * (ħ : ℂ)) ^ b‖ₑ.toReal = ((‖ħ‖₊ ^ b : ℝ≥0) : ℝ) := by simp
  rw [h, smul_eq_mul]
  rfl

lemma exists_le_sup_of_mem {A : Module.End ℂ 𝓢(ℝ, ℂ)} (hA : A ∈ monoSpan ħ) :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ≥0), l2Core.toSeminorm.comp A ≤ C • s.sup l2Family := by
  induction hA using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨a, b⟩, rfl⟩ := hx
    exact ⟨{(a, b)}, ‖ħ‖₊ ^ b, by rw [toSeminorm_comp_mono, Finset.sup_singleton]⟩
  | zero => exact ⟨∅, 0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨s, C, hC⟩ := hx
    obtain ⟨t, D, hD⟩ := hy
    refine ⟨s ∪ t, C + D, (Seminorm.comp_add_le _ _ _).trans ?_⟩
    rw [add_smul]
    exact add_le_add (hC.trans (IsOrderedSMul.smul_le_smul le_rfl
      (Finset.sup_mono Finset.subset_union_left)))
      (hD.trans (IsOrderedSMul.smul_le_smul le_rfl (Finset.sup_mono Finset.subset_union_right)))
  | smul r x _ hx =>
    obtain ⟨s, C, hC⟩ := hx
    refine ⟨s, ‖r‖₊ * C, ?_⟩
    rw [Seminorm.comp_smul, mul_smul]
    exact IsOrderedSMul.smul_le_smul le_rfl hC

/-- Example 3: for `ħ ≠ 0`, the seminorms `‖Af‖` of Corollary 2 generate the usual topology of
`𝓢(ℝ)`. -/
theorem withSeminorms_schwartz (hħ : ħ ≠ 0) : WithSeminorms (seminormFamily l2Core (obs ħ)) := by
  refine withSeminorms_l1_l2.2.congr (fun A => ?_) (fun ab => ?_)
  · obtain ⟨s, C, hC⟩ := exists_le_sup_of_mem ħ (algebra_le_monoSpan ħ A.2)
    exact ⟨s, C, hC⟩
  · obtain ⟨a, b⟩ := ab
    have hpos : ‖ħ‖₊ ^ b ≠ 0 := pow_ne_zero _ (nnnorm_ne_zero_iff.mpr hħ)
    refine ⟨{⟨mono ħ a b, mono_mem_algebra ħ a b⟩}, (‖ħ‖₊ ^ b)⁻¹, ?_⟩
    rw [Finset.sup_singleton, Seminorm.comp_id]
    change l2Family (a, b) ≤ (‖ħ‖₊ ^ b)⁻¹ • l2Core.toSeminorm.comp (mono ħ a b)
    rw [toSeminorm_comp_mono, inv_smul_smul₀ hpos]

/-- Example 3: the topology of Corollary 2 on `𝓢(ℝ)` is the Schwartz topology. -/
theorem topology_schwartz (hħ : ħ ≠ 0) :
    topology l2Core (obs ħ) = (inferInstance : TopologicalSpace 𝓢(ℝ, ℂ)) :=
  (withSeminorms_schwartz ħ hħ).1.symm

/-- Example 3: the Schwartz topology is admissible, so `X` and `P` are continuous and the
inner product is jointly continuous. -/
theorem isAdmissible_schwartz (hħ : ħ ≠ 0) :
    IsAdmissible l2Core (obs ħ) (inferInstance : TopologicalSpace 𝓢(ℝ, ℂ)) :=
  topology_schwartz ħ hħ ▸ isAdmissible_topology l2Core (obs ħ)

end Schwartz

/-! ### Example 4: the qubit -/

section Qubit

open Matrix Complex

/-- The Pauli matrices `σ₁, σ₂, σ₃` (indexed by `Fin 3`). -/
def pauli : Fin 3 → Matrix (Fin 2) (Fin 2) ℂ :=
  ![!![0, 1; 1, 0], !![0, -I; I, 0], !![1, 0; 0, -1]]

/-- `[σᵢ, σᵢ₊₁] = 2i σᵢ₊₂`. -/
lemma pauli_comm (i : Fin 3) :
    pauli i * pauli (i + 1) - pauli (i + 1) * pauli i = (2 * I) • pauli (i + 2) := by
  fin_cases i <;> ext a b <;> fin_cases a <;> fin_cases b <;>
    simp [pauli] <;> ring_nf <;> simp [I_sq]

lemma isHermitian_spinMatrix (ħ : ℝ) (i : Fin 3) : ((ħ / 2 : ℂ) • pauli i).IsHermitian := by
  fin_cases i <;> ext a b <;> fin_cases a <;> fin_cases b <;> simp [pauli, ← ofReal_ofNat,
    ← ofReal_div, conj_ofReal]

/-- The spin observables `Sᵢ = (ħ/2) σᵢ` on `ℂ²`. -/
def spin (ħ : ℝ) (i : Fin 3) : Module.End ℂ (EuclideanSpace ℂ (Fin 2)) :=
  toEuclideanLin ((ħ / 2 : ℂ) • pauli i)

/-- Example 4: `[Sᵢ, Sᵢ₊₁] = iħ Sᵢ₊₂`, i.e. `[Sᵢ, Sⱼ]/(iħ) = εᵢⱼₖ Sₖ`. -/
theorem spin_comm (ħ : ℝ) (i : Fin 3) :
    spin ħ i * spin ħ (i + 1) - spin ħ (i + 1) * spin ħ i = (I * ħ) • spin ħ (i + 2) := by
  simp only [spin, ← toEuclideanLin_mul, ← map_sub, ← map_smul]
  congr 1
  rw [smul_mul_smul_comm, smul_mul_smul_comm, ← smul_sub, pauli_comm, smul_smul, smul_smul]
  congr 1
  ring

/-- The inner product of `ℂ²`. -/
abbrev qubitCore : PreInnerProductSpace.Core ℂ (EuclideanSpace ℂ (Fin 2)) :=
  PreInnerProductSpace.toCore

/-- Example 4: the spin observables are symmetric. -/
theorem isSymmetric_spin (ħ : ℝ) (i : Fin 3) : IsSymmetric qubitCore (spin ħ i) :=
  isSymmetric_toEuclideanLin_iff.mpr (isHermitian_spinMatrix ħ i)

/-- Example 4: the topology of Corollary 2 on `ℂ²` is the usual one. -/
theorem topology_qubit (ħ : ℝ) :
    topology qubitCore (spin ħ) =
      (inferInstance : TopologicalSpace (EuclideanSpace ℂ (Fin 2))) := by
  rw [topology_eq_moduleTopology qubitCore (spin ħ) fun v hv => inner_self_eq_zero.mp hv]
  have := isModuleTopologyOfFiniteDimensional (𝕜 := ℂ) (E := EuclideanSpace ℂ (Fin 2))
  exact (eq_moduleTopology ℂ _).symm

end Qubit

end QuantumVectorSpaces
