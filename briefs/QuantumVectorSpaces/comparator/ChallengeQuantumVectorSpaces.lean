open Topology
open scoped NNReal
@[expose] public noncomputable section
namespace QuantumVectorSpaces
section Corollary2
variable {V : Type*} [AddCommGroup V] [Module ℂ V] (c : PreInnerProductSpace.Core ℂ V)
  {ι : Type*} (X : ι → Module.End ℂ V)
abbrev algebra : Subalgebra ℂ (Module.End ℂ V) := Algebra.adjoin ℂ (Set.range X)
def seminormFamily : SeminormFamily ℂ V (algebra X) := fun A => c.toSeminorm.comp A.1
@[instance_reducible]
def topology : TopologicalSpace V := (seminormFamily c X).moduleFilterBasis.topology
structure IsAdmissible (t : TopologicalSpace V) : Prop where
  isTopologicalAddGroup : IsTopologicalAddGroup V
  continuousSMul : ContinuousSMul ℂ V
  continuous_obs (i : ι) : Continuous (X i)
  continuous_inner : Continuous fun p : V × V => c.inner p.1 p.2
def IsSymmetric (A : Module.End ℂ V) : Prop := ∀ v w, c.inner (A v) w = c.inner v (A w)
theorem withSeminorms : letI := topology c X; WithSeminorms (seminormFamily c X) :=
  letI := topology c X; ⟨rfl⟩
theorem IsAdmissible.continuous_expectation {t : TopologicalSpace V} (ht : IsAdmissible c X t)
    (A : algebra X) : Continuous fun v => c.inner v (A.1 v) := by
  sorry
theorem isGreatest_topology : IsGreatest {t | IsAdmissible c X t} (topology c X) := by
  sorry
theorem locallyConvexSpace : letI := topology c X; LocallyConvexSpace ℝ V := by
  sorry
@[instance_reducible]
def uniformSpace : UniformSpace V :=
  letI := topology c X
  haveI := (withSeminorms c X).isTopologicalAddGroup
  IsTopologicalAddGroup.rightUniformSpace V
structure IsQuantumVectorSpace (ħ : ℝ) (C : ι → ι → ι →₀ ℂ) : Prop where
  isSymmetric (i : ι) : IsSymmetric c (X i)
  comm (i j : ι) :
    X i * X j - X j * X i = (Complex.I * ħ) • Finsupp.linearCombination ℂ X (C i j)
  completeSpace : @CompleteSpace V (uniformSpace c X)
  secondCountableTopology : @SecondCountableTopology V (topology c X)
end Corollary2
section Schwartz
open SchwartzMap MeasureTheory Complex ComplexConjugate
open scoped NNReal
@[instance_reducible]
def l2Core : PreInnerProductSpace.Core ℂ 𝓢(ℝ, ℂ) where
  inner f g := inner ℂ (f.toLp 2) (g.toLp 2)
  conj_inner_symm f g := inner_conj_symm _ _
  re_inner_nonneg f := inner_self_nonneg (𝕜 := ℂ) (x := f.toLp 2)
  add_left f g h := by
    rw [← toLpCLM_apply (𝕜 := ℂ), map_add, inner_add_left]
    rfl
  smul_left f g r := by
    rw [← toLpCLM_apply (𝕜 := ℂ), map_smul, inner_smul_left]
    rfl
def posOp : Module.End ℂ 𝓢(ℝ, ℂ) := (smulLeftCLM ℂ Complex.ofReal).toLinearMap
variable (ħ : ℝ)
def obsConst (i j : Fin 3) : Fin 3 →₀ ℂ :=
  if i = 0 ∧ j = 1 then Finsupp.single 2 1
  else if i = 1 ∧ j = 0 then Finsupp.single 2 (-1) else 0
end Schwartz
section Qubit
open Matrix Complex
def pauli : Fin 3 → Matrix (Fin 2) (Fin 2) ℂ :=
  ![!![0, 1; 1, 0], !![0, -I; I, 0], !![1, 0; 0, -1]]
def spin (ħ : ℝ) (i : Fin 3) : Module.End ℂ (EuclideanSpace ℂ (Fin 2)) :=
  toEuclideanLin ((ħ / 2 : ℂ) • pauli i)
abbrev qubitCore : PreInnerProductSpace.Core ℂ (EuclideanSpace ℂ (Fin 2)) :=
  PreInnerProductSpace.toCore
def levi (i j : Fin 3) : Fin 3 →₀ ℂ :=
  if j = i + 1 then Finsupp.single (i + 2) 1
  else if i = j + 1 then Finsupp.single (j + 2) (-1) else 0
theorem isQuantumVectorSpace_qubit (ħ : ℝ) : IsQuantumVectorSpace qubitCore (spin ħ) ħ levi := by
  sorry
end Qubit
inductive ObsN (n : ℕ)
  | pos (i : Fin n)
  | mom (i : Fin n)
  | one
  deriving DecidableEq, Fintype
section SchwartzN
open SchwartzMap MeasureTheory Complex ComplexConjugate LineDeriv
variable (n : ℕ)
set_option hygiene false in
local notation "𝓢ₙ" => 𝓢(EuclideanSpace ℝ (Fin n), ℂ)
@[instance_reducible]
def l2CoreN : PreInnerProductSpace.Core ℂ 𝓢ₙ where
  inner f g := inner ℂ (f.toLp 2) (g.toLp 2)
  conj_inner_symm f g := inner_conj_symm _ _
  re_inner_nonneg f := inner_self_nonneg (𝕜 := ℂ) (x := f.toLp 2)
  add_left f g h := by
    rw [← toLpCLM_apply (𝕜 := ℂ), map_add, inner_add_left]
    rfl
  smul_left f g r := by
    rw [← toLpCLM_apply (𝕜 := ℂ), map_smul, inner_smul_left]
    rfl
def coord (i : Fin n) (x : EuclideanSpace ℝ (Fin n)) : ℂ := x i
abbrev unitVec (i : Fin n) : EuclideanSpace ℝ (Fin n) := EuclideanSpace.single i 1
def posOpN (i : Fin n) : Module.End ℂ 𝓢ₙ := (smulLeftCLM ℂ (coord n i)).toLinearMap
def derivN (i : Fin n) : Module.End ℂ 𝓢ₙ := (lineDerivOpCLM ℂ 𝓢ₙ (unitVec n i)).toLinearMap
def momOpN (ħ : ℝ) (i : Fin n) : Module.End ℂ 𝓢ₙ :=
  ((-I * ħ) • lineDerivOpCLM ℂ 𝓢ₙ (unitVec n i)).toLinearMap
def obsN (ħ : ℝ) : ObsN n → Module.End ℂ 𝓢ₙ
  | .pos i => posOpN n i
  | .mom i => momOpN n ħ i
  | .one => 1
variable (ħ : ℝ)
def obsNConst : ObsN n → ObsN n → ObsN n →₀ ℂ
  | .pos i, .mom j => if i = j then Finsupp.single .one 1 else 0
  | .mom j, .pos i => if i = j then Finsupp.single .one (-1) else 0
  | _, _ => 0
variable {ħ}
theorem topology_schwartzN (hħ : ħ ≠ 0) :
    topology (l2CoreN n) (obsN n ħ) = (inferInstance : TopologicalSpace 𝓢ₙ) := by
  sorry
theorem isQuantumVectorSpace_schwartzN (hħ : ħ ≠ 0) :
    IsQuantumVectorSpace (l2CoreN n) (obsN n ħ) ħ (obsNConst n) := by
  sorry
end SchwartzN
