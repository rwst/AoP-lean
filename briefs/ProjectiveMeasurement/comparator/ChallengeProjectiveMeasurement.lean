def spectrumFinset (X : E →L[ℂ] E) : Finset ℝ := (X.finite_spectrum ℝ).toFinset
variable [CompleteSpace E]
def spectralProj (X : E →L[ℂ] E) (x : ℝ) : E →L[ℂ] E := cfc (({x} : Set ℝ).indicator 1) X
variable {X : E →L[ℂ] E}
