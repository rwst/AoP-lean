module

public import SchwartzNorms

/-!
# The moments see only distances to `0`

The Remark after Theorem 1 of the brief: the topology of `𝓢(ℝ)` is generated by the seminorms
`‖f‖^{L²}_{α,β} = ‖x^α ∂^β f‖_{L²}` (`SchwartzNorms.l2Seminorm`), but "the moments, then, can only
give information about all distances to 0, and not to all other functions". Made precise:

* `matrixElement_eq_of_moment_eq`  the moments `⟨ψ|XᵐPⁿ|ψ⟩` determine `⟨ψ|A|ψ⟩` for every
  polynomial `A` in `X` and `P`, since these polynomials are spanned by the `XᵐPⁿ`
  (`adjoin_le_monomials`, from `[P, X] = -iħ`, `P_mul_X`);
* `matrixElement_P_pow_X_pow_P_pow`  `⟨ψ|P^β X^{2α} P^β|ψ⟩ = ħ^{2β} (‖ψ‖^{L²}_{α,β})²`, by
  integration by parts (`P` is symmetric, `matrixElement_P_mul`);
* `l2Seminorm_eq_of_moment_eq`  so for `ħ ≠ 0` the moments of `ψ` determine all its `L²`
  seminorms, its "distances to 0";
* `l2Seminorm_psi`  in particular all the states `ψ_θ` have the same seminorms;
* `exists_same_seminorms`  but not the distances to other functions: `ψ₀` and `ψ_π` have the
  same moments and the same seminorms, yet `‖ψ₀ - ψ_π‖_{L²} > 0`.
-/

open Complex ComplexConjugate MeasureTheory SchwartzMap SchwartzNorms

@[expose] public noncomputable section

namespace SchwartzMomentProblem

/-! ### The moments determine every polynomial in `X` and `P` -/

/-- The span of the monomials `Xᵐ Pⁿ`. -/
def monomials (ħ : ℝ) : Submodule ℂ (Module.End ℂ 𝓢(ℝ, ℂ)) :=
  Submodule.span ℂ (Set.range fun mn : ℕ × ℕ => X ^ mn.1 * P ħ ^ mn.2)

/-- The canonical commutation relation `PX = XP - iħ`. -/
lemma P_mul_X (ħ : ℝ) : P ħ * X = X * P ħ + (-I * ħ) • 1 := by
  refine LinearMap.ext fun φ => SchwartzMap.ext fun x => ?_
  have hX : (⇑(X φ)) = fun y : ℝ => (y : ℂ) * φ y := funext (X_apply φ)
  have h1 : HasDerivAt (fun y : ℝ => (y : ℂ)) 1 x := by simpa using (hasDerivAt_id x).ofReal_comp
  have hd : deriv (fun y : ℝ => (y : ℂ) * φ y) x = 1 * φ x + x * deriv φ x :=
    (h1.mul (φ.hasDerivAt x)).deriv
  simp only [mul_apply_eq_comp, LinearMap.add_apply, LinearMap.smul_apply, one_apply_eq_self,
    add_apply, smul_apply, smul_eq_mul, P_apply, X_apply, hX, hd]
  ring

variable {ħ : ℝ}

lemma X_mul_mem {B : Module.End ℂ 𝓢(ℝ, ℂ)} (hB : B ∈ monomials ħ) : X * B ∈ monomials ħ := by
  induction hB using Submodule.span_induction with
  | mem B hB =>
    obtain ⟨⟨m, n⟩, rfl⟩ := hB
    exact Submodule.subset_span ⟨(m + 1, n), by simp [pow_succ', mul_assoc]⟩
  | zero => simp
  | add A B _ _ hA hB => rw [mul_add]; exact add_mem hA hB
  | smul c B _ hB => rw [mul_smul_comm]; exact Submodule.smul_mem _ c hB

lemma P_mul_monomial_mem (m n : ℕ) : P ħ * (X ^ m * P ħ ^ n) ∈ monomials ħ := by
  induction m with
  | zero => exact Submodule.subset_span ⟨(0, n + 1), by simp [pow_succ']⟩
  | succ m ih =>
    rw [pow_succ', mul_assoc, ← mul_assoc (P ħ), P_mul_X, add_mul, mul_assoc, smul_mul_assoc,
      one_mul]
    exact add_mem (X_mul_mem ih) (Submodule.smul_mem _ _ (Submodule.subset_span ⟨(m, n), rfl⟩))

lemma P_mul_mem {B : Module.End ℂ 𝓢(ℝ, ℂ)} (hB : B ∈ monomials ħ) : P ħ * B ∈ monomials ħ := by
  induction hB using Submodule.span_induction with
  | mem B hB =>
    obtain ⟨⟨m, n⟩, rfl⟩ := hB
    exact P_mul_monomial_mem m n
  | zero => simp
  | add A B _ _ hA hB => rw [mul_add]; exact add_mem hA hB
  | smul c B _ hB => rw [mul_smul_comm]; exact Submodule.smul_mem _ c hB

/-- Every polynomial in `X` and `P` is a linear combination of the monomials `Xᵐ Pⁿ`. -/
theorem adjoin_le_monomials {A : Module.End ℂ 𝓢(ℝ, ℂ)} (hA : A ∈ Algebra.adjoin ℂ {X, P ħ}) :
    A ∈ monomials ħ := by
  have key : ∀ B ∈ monomials ħ, A * B ∈ monomials ħ := by
    induction hA using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      exacts [fun B hB => X_mul_mem hB, fun B hB => P_mul_mem hB]
    | algebraMap r =>
      intro B hB
      rw [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
      exact Submodule.smul_mem _ r hB
    | add x y _ _ hx hy => intro B hB; rw [add_mul]; exact add_mem (hx B hB) (hy B hB)
    | mul x y _ _ hx hy => intro B hB; rw [mul_assoc]; exact hx _ (hy B hB)
  simpa using key 1 (Submodule.subset_span ⟨(0, 0), by simp⟩)

lemma matrixElement_add (A B : Module.End ℂ 𝓢(ℝ, ℂ)) (φ χ : 𝓢(ℝ, ℂ)) :
    matrixElement (A + B) φ χ = matrixElement A φ χ + matrixElement B φ χ := by
  simp only [matrixElement, LinearMap.add_apply, add_apply, mul_add]
  exact integral_add (integrable_conj_mul _ _) (integrable_conj_mul _ _)

lemma matrixElement_smul (c : ℂ) (A : Module.End ℂ 𝓢(ℝ, ℂ)) (φ χ : 𝓢(ℝ, ℂ)) :
    matrixElement (c • A) φ χ = c * matrixElement A φ χ := by
  simp only [matrixElement, LinearMap.smul_apply, smul_apply, smul_eq_mul, mul_left_comm _ c]
  exact integral_const_mul _ _

/-- The moments `⟨ψ|XᵐPⁿ|ψ⟩` determine `⟨ψ|A|ψ⟩` for every polynomial `A` in `X` and `P`. -/
theorem matrixElement_eq_of_moment_eq {ψ₁ ψ₂ : 𝓢(ℝ, ℂ)}
    (h : ∀ m n, moment ħ ψ₁ m n = moment ħ ψ₂ m n) {A : Module.End ℂ 𝓢(ℝ, ℂ)}
    (hA : A ∈ Algebra.adjoin ℂ {X, P ħ}) : matrixElement A ψ₁ ψ₁ = matrixElement A ψ₂ ψ₂ := by
  have hM := adjoin_le_monomials hA
  clear hA
  induction hM using Submodule.span_induction with
  | mem B hB =>
    obtain ⟨⟨m, n⟩, rfl⟩ := hB
    simpa only [moment_eq_matrixElement] using h m n
  | zero => simp [matrixElement]
  | add A B _ _ hA hB => rw [matrixElement_add, matrixElement_add, hA, hB]
  | smul c B _ hB => rw [matrixElement_smul, matrixElement_smul, hB]

/-! ### Squared seminorms are moments -/

/-- Integration by parts, `∫ conj φ · χ' = -∫ conj φ' · χ`. -/
lemma integral_conj_mul_deriv (φ χ : 𝓢(ℝ, ℂ)) :
    ∫ x, conj (φ x) * deriv χ x = -∫ x, conj (deriv φ x) * χ x :=
  integral_bilinear_deriv_right_eq_neg_left φ χ
    ((ContinuousLinearMap.mul ℝ ℂ).comp conjCLE.toContinuousLinearMap)

/-- `P` is symmetric: `⟨φ|P B|χ⟩ = ∫ conj (Pφ) · Bχ`. -/
lemma matrixElement_P_mul (ħ : ℝ) (B : Module.End ℂ 𝓢(ℝ, ℂ)) (φ χ : 𝓢(ℝ, ℂ)) :
    matrixElement (P ħ * B) φ χ = ∫ x, conj (P ħ φ x) * B χ x := by
  have h1 : (fun x => conj (φ x) * (P ħ * B) χ x) =
      fun x => (-I * ħ) * (conj (φ x) * deriv (B χ) x) := by
    ext x; rw [mul_apply_eq_comp, P_apply]; ring
  have h2 : (fun x => conj (P ħ φ x) * B χ x) =
      fun x => (I * ħ) * (conj (deriv φ x) * B χ x) := by
    ext x; simp only [P_apply, map_mul, map_neg, conj_I, conj_ofReal]; ring
  rw [matrixElement, h1, h2, integral_const_mul, integral_const_mul, integral_conj_mul_deriv]
  ring

lemma matrixElement_P_pow_mul (ħ : ℝ) (n : ℕ) (B : Module.End ℂ 𝓢(ℝ, ℂ)) (φ χ : 𝓢(ℝ, ℂ)) :
    matrixElement (P ħ ^ n * B) φ χ = ∫ x, conj ((P ħ ^ n) φ x) * B χ x := by
  induction n generalizing B with
  | zero => simp [matrixElement]
  | succ n ih =>
    rw [pow_succ, mul_assoc, ih]
    change matrixElement (P ħ * B) ((P ħ ^ n) φ) χ = _
    rw [matrixElement_P_mul, ← mul_apply_eq_comp, ← pow_succ', ← pow_succ]

/-- `(‖ψ‖^{L²}_{α,β})² = ∫ |x^α ψ⁽ᵝ⁾(x)|² dx`. -/
lemma l2Seminorm_sq (α β : ℕ) (ψ : 𝓢(ℝ, ℂ)) :
    l2Seminorm α β ψ ^ 2 = ∫ x, ‖weighted α β ψ x‖ ^ 2 := by
  have hc := continuous_weighted (ψ.smooth ⊤) α β
  rw [integral_eq_lintegral_of_nonneg_ae (f := fun x => ‖weighted α β ψ x‖ ^ 2)
    (ae_of_all _ fun x => by positivity)
    (hc.norm.pow 2).aestronglyMeasurable]
  have h : ∫⁻ x, ENNReal.ofReal (‖weighted α β ψ x‖ ^ 2) = ∫⁻ x, ‖weighted α β ψ x‖ₑ ^ 2 := by
    congr 1; ext x; rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
  rw [h, ← l2Norm_sq (ψ.smooth ⊤), l2Norm_eq_ofReal, ← ENNReal.ofReal_pow (apply_nonneg _ _),
    ENNReal.toReal_ofReal (by positivity)]
  rfl

/-- The squared seminorm is a moment: `⟨ψ|P^β X^{2α} P^β|ψ⟩ = ħ^{2β} (‖ψ‖^{L²}_{α,β})²`. -/
theorem matrixElement_P_pow_X_pow_P_pow (ħ : ℝ) (α β : ℕ) (ψ : 𝓢(ℝ, ℂ)) :
    matrixElement (P ħ ^ β * (X ^ (2 * α) * P ħ ^ β)) ψ ψ =
      ((ħ ^ (2 * β) * l2Seminorm α β ψ ^ 2 : ℝ) : ℂ) := by
  have h : ∀ x, conj ((P ħ ^ β) ψ x) * (X ^ (2 * α) * P ħ ^ β) ψ x =
      ((ħ ^ (2 * β) * ‖weighted α β ψ x‖ ^ 2 : ℝ) : ℂ) := by
    intro x
    set z := (P ħ ^ β) ψ x
    have hz : ‖z‖ = |ħ| ^ β * ‖iteratedDeriv β ψ x‖ := by
      simp [z, P_pow_apply, norm_pow]
    have hw : ‖weighted α β ψ x‖ = |x| ^ α * ‖iteratedDeriv β ψ x‖ := by
      simp [weighted, norm_pow]
    have hc : conj z * (X ^ (2 * α) * P ħ ^ β) ψ x = ((x ^ (2 * α) * ‖z‖ ^ 2 : ℝ) : ℂ) := by
      rw [mul_apply_eq_comp, X_pow_apply, mul_left_comm, conj_mul']
      push_cast; ring
    rw [hc, hz, hw]
    congr 1
    rw [pow_mul x, pow_mul ħ, ← sq_abs x, ← sq_abs ħ]
    ring
  rw [matrixElement_P_pow_mul, funext h, integral_complex_ofReal, integral_const_mul, l2Seminorm_sq]

/-! ### The moments see only distances to `0` -/

/-- For `ħ ≠ 0` the moments of `ψ` determine all its `L²` seminorms `‖ψ‖^{L²}_{α,β}`. -/
theorem l2Seminorm_eq_of_moment_eq (hħ : ħ ≠ 0) {ψ₁ ψ₂ : 𝓢(ℝ, ℂ)}
    (h : ∀ m n, moment ħ ψ₁ m n = moment ħ ψ₂ m n) (α β : ℕ) :
    l2Seminorm α β ψ₁ = l2Seminorm α β ψ₂ := by
  have hA : P ħ ^ β * (X ^ (2 * α) * P ħ ^ β) ∈ Algebra.adjoin ℂ {X, P ħ} :=
    have hX := Algebra.subset_adjoin (R := ℂ) (s := {X, P ħ}) (by simp : X ∈ _)
    have hP := Algebra.subset_adjoin (R := ℂ) (s := {X, P ħ}) (by simp : P ħ ∈ _)
    Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hP β)
      (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hX _) (Subalgebra.pow_mem _ hP β))
  have h2 := matrixElement_eq_of_moment_eq h hA
  rw [matrixElement_P_pow_X_pow_P_pow, matrixElement_P_pow_X_pow_P_pow, ofReal_inj] at h2
  exact (sq_eq_sq₀ (apply_nonneg _ _) (apply_nonneg _ _)).1
    (mul_left_cancel₀ (pow_ne_zero _ hħ) h2)

/-- All the states `ψ_θ` have the same `L²` seminorms. -/
theorem l2Seminorm_psi {f g : 𝓢(ℝ, ℂ)} (hfg : Disjoint (tsupport f) (tsupport g)) (θ θ' : ℝ)
    (α β : ℕ) : l2Seminorm α β (psi f g θ) = l2Seminorm α β (psi f g θ') :=
  l2Seminorm_eq_of_moment_eq one_ne_zero
    (fun m n => by rw [moment_psi_of_disjoint 1 hfg, moment_psi_of_disjoint 1 hfg]) α β

/-- A nonzero Schwartz function has positive `L²` norm. -/
lemma l2Seminorm_zero_zero_pos {χ : 𝓢(ℝ, ℂ)} (hχ : χ ≠ 0) : 0 < l2Seminorm 0 0 χ := by
  refine (apply_nonneg _ _).lt_of_ne (Ne.symm fun h0 => hχ ?_)
  have hw : weighted 0 0 ⇑χ = ⇑χ := funext fun x => by simp [weighted]
  have h1 : l2Norm 0 0 χ = 0 := by
    rw [l2Norm_eq_ofReal]; exact ENNReal.ofReal_eq_zero.2 h0.le
  rw [l2Norm, hw, eLpNorm_eq_zero_iff two_ne_zero] at h1
  exact SchwartzMap.ext fun x =>
    congrFun ((χ.continuous.ae_eq_iff_eq volume continuous_const).1 h1) x

/-- The moments see only distances to `0`: `ψ₀` and `ψ_π` have the same moments, for every `ħ`,
and the same `L²` seminorms, but their distance `‖ψ₀ - ψ_π‖_{L²}` is positive. -/
theorem exists_same_seminorms :
    ∃ ψ₁ ψ₂ : 𝓢(ℝ, ℂ), (∀ ħ m n, moment ħ ψ₁ m n = moment ħ ψ₂ m n) ∧
      (∀ α β, l2Seminorm α β ψ₁ = l2Seminorm α β ψ₂) ∧ 0 < l2Seminorm 0 0 (ψ₁ - ψ₂) := by
  have hdisj : Disjoint (tsupport (bump 0)) (tsupport (bump 3)) :=
    (Metric.closedBall_disjoint_closedBall (by norm_num [Real.dist_eq])).mono
      (tsupport_bump_subset 0) (tsupport_bump_subset 3)
  have hθ : exp ((0 : ℝ) * I) ≠ exp ((Real.pi : ℝ) * I) := by
    rw [ofReal_zero, zero_mul, exp_zero, exp_pi_mul_I]
    norm_num
  have hne : psi (bump 0) (bump 3) 0 ≠ psi (bump 0) (bump 3) Real.pi := by
    simpa using (linearIndependent_psi (bump_ne_zero 0) (bump_ne_zero 3) hdisj hθ).injective.ne
      (show (0 : Fin 2) ≠ 1 by decide)
  refine ⟨psi (bump 0) (bump 3) 0, psi (bump 0) (bump 3) Real.pi, fun ħ m n => ?_,
    l2Seminorm_psi hdisj 0 Real.pi, l2Seminorm_zero_zero_pos (sub_ne_zero.2 hne)⟩
  rw [moment_psi_of_disjoint ħ hdisj, moment_psi_of_disjoint ħ hdisj]

end SchwartzMomentProblem
