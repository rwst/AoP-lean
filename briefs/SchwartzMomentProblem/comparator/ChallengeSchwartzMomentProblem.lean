    (h : ∀ m n, moment ħ ψ₁ m n = moment ħ ψ₂ m n) {A : Module.End ℂ 𝓢(ℝ, ℂ)}
    (hA : A ∈ Algebra.adjoin ℂ {X, P ħ}) : matrixElement A ψ₁ ψ₁ = matrixElement A ψ₂ ψ₂ := by
