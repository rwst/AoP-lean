variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {Φ : E → E}
  {Φ' : E → E →L[ℝ] E} {ρ g : E → ℝ}
noncomputable def pushDensity (Φ : E → E) (Φ' : E → E →L[ℝ] E) (ρ : E → ℝ) : E → ℝ :=
  Function.extend Φ (fun x => ρ x / |(Φ' x).det|) 0
