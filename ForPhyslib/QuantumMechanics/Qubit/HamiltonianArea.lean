module

public import ForPhyslib.QuantumMechanics.Qubit.HamiltonianIsotopy
public import Mathlib.Analysis.SpecialFunctions.Log.NegMulLog
public import TauCeti.Geometry.Symplectic.Manifold.LiouvilleMeasure
import ForMathlib.Geometry.Symplectic.Hamiltonian.Parametric
import ForMathlib.Geometry.Symplectic.Manifold.LiouvilleMeasure
import ForMathlib.MeasureTheory.Measure.WithDensity.MeasurePreserving

/-!
# Hamiltonian evolution of the classical qubit: one Hamiltonian, area and entropy

Three refinements of the characterization of Hamiltonian evolution on the Riemann sphere
`OnePoint ℂ ≅ ℙ ℂ (Fin 2 → ℂ)` by the Fubini–Study form `ω_FS`
(`QuantumMechanics.Qubit.forall_mpullback_isotopy_fubiniStudyForm_iff`).

* **One jointly smooth Hamiltonian.** The Hamiltonians `H t` of an area-form-preserving evolution
  are found one time at a time. They can be chosen jointly smooth in `(t, x)`, normalized by
  `H t ∞ = 0` (`TauCeti.SmoothTwoForm.exists_contMDiff_isHamiltonianVectorField`).
* **Area instead of area form.** Along an isotopy from the identity, preserving the Liouville
  measure of `ω_FS`, the area, is the same as preserving `ω_FS`
  (`TauCeti.SmoothTwoForm.forall_measurePreserving_isotopy_iff`). So Hamiltonian evolution is
  exactly the area-preserving evolution, as Example 2 of the brief says. For single maps this
  fails: complex conjugation preserves the area and reverses `ω_FS`
  (`QuantumMechanics.Qubit.ne_conjSphere_of_mpullback_eq`).
* **Conservation of entropy.** A Hamiltonian evolution carries an ensemble with density `ρ` with
  respect to the Liouville measure to the ensemble with density `ρ ∘ φ_t⁻¹`, which has the same
  Gibbs entropy `∫ -ρ log ρ`.

## Main results

* `QuantumMechanics.Qubit.exists_contMDiff_hamiltonian_isotopy`: an isotopy preserving `ω_FS` is
  generated by one jointly smooth Hamiltonian.
* `QuantumMechanics.Qubit.exists_contMDiff_hamiltonian_timeDependentFlowOf`: the same for the
  time-dependent flow of a vector field.
* `QuantumMechanics.Qubit.forall_measurePreserving_isotopy_iff`: an isotopy from the identity
  preserves the Liouville measure exactly when it preserves `ω_FS`.
* `QuantumMechanics.Qubit.forall_measurePreserving_isotopy_iff_hamiltonian`: exactly when it is
  generated by one jointly smooth Hamiltonian.
* `QuantumMechanics.Qubit.map_withDensity_isotopy`,
  `QuantumMechanics.Qubit.integral_negMulLog_isotopy`: Hamiltonian evolution moves densities by
  `ρ ↦ ρ ∘ φ_t⁻¹` and conserves their Gibbs entropy.
-/

public section

open Module MeasureTheory Real
open scoped ContDiff Manifold

namespace QuantumMechanics.Qubit

open OnePoint (fubiniStudyForm isSymplectic_fubiniStudyForm)
open TauCeti
open scoped TauCeti.ComplexManifold

/-- The Riemann sphere is a surface: its model space `ℂ` has real dimension `2 · 1`. -/
instance fact_finrank_complex_two_mul_one : Fact (finrank ℝ ℂ = 2 * 1) :=
  ⟨Complex.finrank_real_complex⟩

variable {φ ψ : ℝ → OnePoint ℂ → OnePoint ℂ}

/-! ### One jointly smooth Hamiltonian -/

/-- **An area-form-preserving time-dependent flow has one jointly smooth Hamiltonian.** If the
time-dependent flow of a jointly smooth time-dependent vector field `X` on the Riemann sphere
preserves `ω_FS`, then there is one jointly smooth `H (t, x)` with `H t ∞ = 0` such that each
`X t` is the Hamiltonian vector field of `H t`. -/
theorem exists_contMDiff_hamiltonian_timeDependentFlowOf
    {X : ℝ → (x : OnePoint ℂ) → TangentSpace 𝓘(ℝ, ℂ) x}
    (hX : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ).tangent ∞
      (fun p : ℝ × OnePoint ℂ ↦ (⟨p.2, X p.1 p.2⟩ : TangentBundle 𝓘(ℝ, ℂ) (OnePoint ℂ))))
    (h : ∀ s t, mpullback 𝓘(ℝ, ℂ) 𝓘(ℝ, ℂ) (timeDependentFlowOf X s t) fubiniStudyForm.1 =
      fubiniStudyForm.1) :
    ∃ H : ℝ → OnePoint ℂ → ℝ,
      ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ) ∞ (fun p : ℝ × OnePoint ℂ ↦ H p.1 p.2) ∧
        (∀ t, H t OnePoint.infty = 0) ∧
          ∀ t, fubiniStudyForm.IsHamiltonianVectorField (H t) (X t) :=
  SmoothTwoForm.exists_contMDiff_isHamiltonianVectorField hX
    (fun t ↦ by
      obtain ⟨f, hf, hfX⟩ := (forall_mpullback_timeDependentFlowOf_fubiniStudyForm_iff hX).1 h t
      exact ⟨f, hf.mdifferentiable (by simp), hfX⟩) OnePoint.infty

/-- **An area-form-preserving isotopy has one jointly smooth Hamiltonian.** If a smooth isotopy
`φ t` of the Riemann sphere from the identity, with jointly smooth inverses `ψ t`, preserves
`ω_FS`, then there is one jointly smooth `H (t, x)` with `H t ∞ = 0` such that every generating
field `X_t = φ̇_t ∘ φ_t⁻¹` is the Hamiltonian vector field of `H t`. -/
theorem exists_contMDiff_hamiltonian_isotopy
    (hφ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ φ p.1 p.2))
    (hψ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ ψ p.1 p.2))
    (hφψ : ∀ t y, φ t (ψ t y) = y) (hψφ : ∀ t x, ψ t (φ t x) = x) (hφ0 : ∀ x, φ 0 x = x)
    (h : ∀ t, mpullback 𝓘(ℝ, ℂ) 𝓘(ℝ, ℂ) (φ t) fubiniStudyForm.1 = fubiniStudyForm.1) :
    ∃ H : ℝ → OnePoint ℂ → ℝ,
      ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ) ∞ (fun p : ℝ × OnePoint ℂ ↦ H p.1 p.2) ∧
        (∀ t, H t OnePoint.infty = 0) ∧
          ∀ t, fubiniStudyForm.IsHamiltonianVectorField (H t) (isotopyField 𝓘(ℝ, ℂ) φ ψ t) :=
  SmoothTwoForm.exists_contMDiff_isHamiltonianVectorField (contMDiff_isotopyField hφ hψ hφψ)
    (fun t ↦ by
      obtain ⟨f, hf, hfX⟩ :=
        (forall_mpullback_isotopy_fubiniStudyForm_iff hφ hψ hφψ hψφ hφ0).1 h t
      exact ⟨f, hf.mdifferentiable (by simp), hfX⟩) OnePoint.infty

/-! ### Area instead of area form -/

variable {_ : MeasurableSpace (OnePoint ℂ)} [BorelSpace (OnePoint ℂ)]

/-- **Area-preserving evolutions of the classical qubit preserve the area form.** A smooth isotopy
`φ t` of the Riemann sphere from the identity, with jointly smooth inverses, preserves the
Liouville measure of `ω_FS` at all times exactly when it preserves `ω_FS`. -/
theorem forall_measurePreserving_isotopy_iff
    (hφ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ φ p.1 p.2))
    (hψ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ ψ p.1 p.2))
    (hφψ : ∀ t y, φ t (ψ t y) = y) (hψφ : ∀ t x, ψ t (φ t x) = x) (hφ0 : ∀ x, φ 0 x = x) :
    (∀ t, MeasurePreserving (φ t) (fubiniStudyForm.liouvilleMeasure 1)
        (fubiniStudyForm.liouvilleMeasure 1)) ↔
      ∀ t, mpullback 𝓘(ℝ, ℂ) 𝓘(ℝ, ℂ) (φ t) fubiniStudyForm.1 = fubiniStudyForm.1 :=
  SmoothTwoForm.forall_measurePreserving_isotopy_iff hφ hψ hφψ hψφ hφ0

/-- **Hamiltonian evolution of the classical qubit is the area-preserving evolution.** A smooth
isotopy `φ t` of the Riemann sphere from the identity, with jointly smooth inverses, preserves the
Liouville measure of `ω_FS` at all times exactly when it is generated by one jointly smooth
Hamiltonian `H (t, x)`: every generating field `X_t = φ̇_t ∘ φ_t⁻¹` is the Hamiltonian vector field
of `H t`. -/
theorem forall_measurePreserving_isotopy_iff_hamiltonian
    (hφ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ φ p.1 p.2))
    (hψ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ ψ p.1 p.2))
    (hφψ : ∀ t y, φ t (ψ t y) = y) (hψφ : ∀ t x, ψ t (φ t x) = x) (hφ0 : ∀ x, φ 0 x = x) :
    (∀ t, MeasurePreserving (φ t) (fubiniStudyForm.liouvilleMeasure 1)
        (fubiniStudyForm.liouvilleMeasure 1)) ↔
      ∃ H : ℝ → OnePoint ℂ → ℝ,
        ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ) ∞ (fun p : ℝ × OnePoint ℂ ↦ H p.1 p.2) ∧
          ∀ t, fubiniStudyForm.IsHamiltonianVectorField (H t) (isotopyField 𝓘(ℝ, ℂ) φ ψ t) := by
  rw [forall_measurePreserving_isotopy_iff hφ hψ hφψ hψφ hφ0]
  refine ⟨fun h ↦ ?_, fun ⟨H, hH, hHX⟩ ↦ ?_⟩
  · obtain ⟨H, hH, -, hHX⟩ := exists_contMDiff_hamiltonian_isotopy hφ hψ hφψ hψφ hφ0 h
    exact ⟨H, hH, hHX⟩
  · exact (forall_mpullback_isotopy_fubiniStudyForm_iff hφ hψ hφψ hψφ hφ0).2 fun t ↦
      ⟨H t, hH.comp ((contMDiff_const (c := t)).prodMk contMDiff_id), hHX t⟩

/-! ### Conservation of entropy -/

/-- The map `φ t` of an isotopy with inverses `ψ t`, as a measurable equivalence. -/
noncomputable def isotopyMeasurableEquiv
    (hφ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ φ p.1 p.2))
    (hψ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ ψ p.1 p.2))
    (hφψ : ∀ t y, φ t (ψ t y) = y) (hψφ : ∀ t x, ψ t (φ t x) = x) (t : ℝ) :
    OnePoint ℂ ≃ₜ OnePoint ℂ where
  toFun := φ t
  invFun := ψ t
  left_inv := hψφ t
  right_inv := hφψ t
  continuous_toFun := (hφ.comp ((contMDiff_const (c := t)).prodMk contMDiff_id)).continuous
  continuous_invFun := (hψ.comp ((contMDiff_const (c := t)).prodMk contMDiff_id)).continuous

/-- A Hamiltonian evolution preserves the Liouville measure, as a measurable equivalence. -/
theorem measurePreserving_isotopyMeasurableEquiv
    (hφ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ φ p.1 p.2))
    (hψ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ ψ p.1 p.2))
    (hφψ : ∀ t y, φ t (ψ t y) = y) (hψφ : ∀ t x, ψ t (φ t x) = x)
    (h : ∀ t, mpullback 𝓘(ℝ, ℂ) 𝓘(ℝ, ℂ) (φ t) fubiniStudyForm.1 = fubiniStudyForm.1) (t : ℝ) :
    MeasurePreserving (isotopyMeasurableEquiv hφ hψ hφψ hψφ t).toMeasurableEquiv
      (fubiniStudyForm.liouvilleMeasure 1) (fubiniStudyForm.liouvilleMeasure 1) :=
  (isotopyMeasurableEquiv hφ hψ hφψ hψφ t).measurePreserving_liouvilleMeasure
    ((hφ.comp ((contMDiff_const (c := t)).prodMk contMDiff_id)).mdifferentiable (by simp)) (h t)

/-- **Hamiltonian evolution moves densities along the flow.** A Hamiltonian evolution `φ t` of the
classical qubit carries the ensemble with density `ρ` with respect to the Liouville measure to the
ensemble with density `ρ ∘ φ_t⁻¹`. -/
theorem map_withDensity_isotopy
    (hφ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ φ p.1 p.2))
    (hψ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ ψ p.1 p.2))
    (hφψ : ∀ t y, φ t (ψ t y) = y) (hψφ : ∀ t x, ψ t (φ t x) = x) (hφ0 : ∀ x, φ 0 x = x)
    (hH : ∀ t, ∃ f : OnePoint ℂ → ℝ, ContMDiff 𝓘(ℝ, ℂ) 𝓘(ℝ) ∞ f ∧
      fubiniStudyForm.IsHamiltonianVectorField f (isotopyField 𝓘(ℝ, ℂ) φ ψ t))
    (ρ : OnePoint ℂ → ENNReal) (t : ℝ) :
    ((fubiniStudyForm.liouvilleMeasure 1).withDensity ρ).map (φ t) =
      (fubiniStudyForm.liouvilleMeasure 1).withDensity (fun y ↦ ρ (ψ t y)) :=
  (measurePreserving_isotopyMeasurableEquiv hφ hψ hφψ hψφ
    ((forall_mpullback_isotopy_fubiniStudyForm_iff hφ hψ hφψ hψφ hφ0).2 hH) t).map_withDensity ρ

/-- **Hamiltonian evolution of the classical qubit conserves the entropy.** The density
`ρ ∘ φ_t⁻¹` of an ensemble moved by a Hamiltonian evolution has the same Gibbs entropy
`∫ -ρ log ρ` with respect to the Liouville measure as `ρ`. -/
theorem integral_negMulLog_isotopy
    (hφ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ φ p.1 p.2))
    (hψ : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, ℂ)) 𝓘(ℝ, ℂ) ∞ (fun p : ℝ × OnePoint ℂ ↦ ψ p.1 p.2))
    (hφψ : ∀ t y, φ t (ψ t y) = y) (hψφ : ∀ t x, ψ t (φ t x) = x) (hφ0 : ∀ x, φ 0 x = x)
    (hH : ∀ t, ∃ f : OnePoint ℂ → ℝ, ContMDiff 𝓘(ℝ, ℂ) 𝓘(ℝ) ∞ f ∧
      fubiniStudyForm.IsHamiltonianVectorField f (isotopyField 𝓘(ℝ, ℂ) φ ψ t))
    (ρ : OnePoint ℂ → ℝ) (t : ℝ) :
    ∫ y, negMulLog (ρ (ψ t y)) ∂(fubiniStudyForm.liouvilleMeasure 1) =
      ∫ x, negMulLog (ρ x) ∂(fubiniStudyForm.liouvilleMeasure 1) :=
  (measurePreserving_isotopyMeasurableEquiv hφ hψ hφψ hψφ
    ((forall_mpullback_isotopy_fubiniStudyForm_iff hφ hψ hφψ hψφ hφ0).2 hH) t
    ).integral_negMulLog_comp_symm ρ

end QuantumMechanics.Qubit
