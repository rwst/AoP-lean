public import Mathlib.Analysis.Normed.Group.Tannery

/-!
# The unitary evolution of a diagonal operator on `ℓ²`

For a real sequence `a : ι → ℝ`, the operators `U t x = (e^{-i a i t} x i)ᵢ` on `ℓ²(ι, ℂ)` are
the unitary group `e^{-i t A}` generated by the diagonal operator `A = lp.diagonal a`. Each
`U t` is defined on the whole space, but the orbit `t ↦ U t x` solves the Schrödinger equation
`d/dt (U t x) = -i A (U t x)` exactly when `x` lies in the domain of `A`: outside the domain
the orbit is differentiable nowhere.

## Main definitions

* `lp.diagonalEvolution a t`: the unitary `U t`, as a linear isometry equivalence.

## Main results

* `lp.diagonalEvolution_mem_diagonalDomain_iff`: `U t` preserves the domain of `A`;
* `lp.hasDerivAt_diagonalEvolution`: on the domain, `t ↦ U t x` has derivative `-i A (U t x)`;
* `lp.not_differentiableAt_diagonalEvolution`: off the domain, it is not differentiable;
* `lp.differentiableAt_diagonalEvolution_iff`: the two together.
-/

open Complex Filter Topology
open scoped lp

@[expose] public noncomputable section

namespace lp

variable {ι : Type*} (a : ι → ℝ)

/-- The phase factor `e^{-i r t}`. -/
def phase (r t : ℝ) : ℂ := exp (((-(r * t) : ℝ) : ℂ) * I)

lemma norm_phase (r t : ℝ) : ‖phase r t‖ = 1 := norm_exp_ofReal_mul_I _

@[simp]
lemma phase_zero (r : ℝ) : phase r 0 = 1 := by simp [phase]

lemma phase_add (r t h : ℝ) : phase r (t + h) = phase r t * phase r h := by
  rw [phase, phase, phase, ← exp_add]
  congr 1
  push_cast
  ring

lemma phase_neg_mul_phase (r t : ℝ) : phase r (-t) * phase r t = 1 := by
  rw [← phase_add, neg_add_cancel, phase]
  simp

lemma hasDerivAt_phase (r t : ℝ) : HasDerivAt (phase r) (-(I * (r * phase r t))) t := by
  have h : HasDerivAt (fun s : ℝ => ((-(r * s) : ℝ) : ℂ) * I) (((-(r * 1) : ℝ) : ℂ) * I) t :=
    (((hasDerivAt_id t).const_mul r).neg.ofReal_comp).mul_const I
  have e : -(I * (r * phase r t)) =
      exp (((-(r * t) : ℝ) : ℂ) * I) * (((-(r * 1) : ℝ) : ℂ) * I) := by
    rw [phase]
    push_cast
    ring
  rw [e]
  exact h.cexp

lemma norm_phase_sub_one_le (r h : ℝ) : ‖phase r h - 1‖ ≤ |r| * |h| := by
  rw [phase, mul_comm]
  refine Real.norm_exp_I_mul_ofReal_sub_one_le.trans_eq ?_
  rw [Real.norm_eq_abs, abs_neg, abs_mul]

/-- Two sequences with the same norms in each coordinate are in `ℓᵖ` together. -/
lemma memℓp_congr_norm {p : ENNReal} {f g : ι → ℂ} (h : ∀ i, ‖f i‖ = ‖g i‖) :
    Memℓp f p ↔ Memℓp g p := by
  rw [← memℓp_norm_iff, ← memℓp_norm_iff (f := g), funext h]

lemma memℓp_phase_mul {p : ENNReal} (t : ℝ) {f : ι → ℂ} :
    Memℓp (fun i => phase (a i) t * f i) p ↔ Memℓp f p :=
  memℓp_congr_norm fun i => by rw [norm_mul, norm_phase, one_mul]

/-- The unitary evolution `U t x = (e^{-i a i t} x i)ᵢ` generated by the diagonal operator with
entries `a`. -/
def diagonalEvolution (t : ℝ) : ℓ²(ι, ℂ) ≃ₗᵢ[ℂ] ℓ²(ι, ℂ) where
  toFun x := ⟨fun i => phase (a i) t * x i, (memℓp_phase_mul a t).2 x.2⟩
  invFun x := ⟨fun i => phase (a i) (-t) * x i, (memℓp_phase_mul a (-t)).2 x.2⟩
  map_add' x y := lp.ext <| funext fun i => by simp [mul_add]; rfl
  map_smul' c x := lp.ext <| funext fun i => by simp [mul_left_comm]
  left_inv x := lp.ext <| funext fun i => by
    simp [← mul_assoc, phase_neg_mul_phase]
  right_inv x := lp.ext <| funext fun i => by
    simpa [← mul_assoc] using congrArg (· * x i) (phase_neg_mul_phase (a i) (-t))
  norm_map' x := by
    have hp : 0 < (2 : ENNReal).toReal := by norm_num
    change ‖(⟨_, _⟩ : ℓ²(ι, ℂ))‖ = _
    rw [norm_eq_tsum_rpow hp, norm_eq_tsum_rpow hp]
    simp [norm_phase]

@[simp]
lemma diagonalEvolution_apply (t : ℝ) (x : ℓ²(ι, ℂ)) (i : ι) :
    diagonalEvolution a t x i = phase (a i) t * x i :=
  rfl

@[simp]
lemma diagonalEvolution_zero : diagonalEvolution a 0 = LinearIsometryEquiv.refl ℂ ℓ²(ι, ℂ) :=
  LinearIsometryEquiv.ext fun x => lp.ext <| funext fun i => by simp

/-- `U t` preserves the domain of the diagonal operator. -/
theorem diagonalEvolution_mem_diagonalDomain_iff (t : ℝ) {x : ℓ²(ι, ℂ)} :
    diagonalEvolution a t x ∈ diagonalDomain a ↔ x ∈ diagonalDomain a := by
  rw [mem_diagonalDomain, mem_diagonalDomain]
  exact memℓp_congr_norm fun i => by simp [norm_phase]

lemma norm_sq_eq_tsum (x : ℓ²(ι, ℂ)) : ‖x‖ ^ 2 = ∑' i, ‖x i‖ ^ 2 := by
  have := norm_rpow_eq_tsum (p := 2) (by norm_num) x
  simpa [Real.rpow_two] using this

/-- On the domain of `A = lp.diagonal a`, the orbit `t ↦ U t x` solves the Schrödinger equation
`d/dt (U t x) = -i A (U t x)`. -/
theorem hasDerivAt_diagonalEvolution {x : ℓ²(ι, ℂ)} (hx : x ∈ diagonalDomain a) (t : ℝ) :
    HasDerivAt (fun s => diagonalEvolution a s x)
      (-(I • diagonal a ⟨diagonalEvolution a t x,
        (diagonalEvolution_mem_diagonalDomain_iff a t).2 hx⟩)) t := by
  set v : ℓ²(ι, ℂ) := -(I • diagonal a ⟨diagonalEvolution a t x,
    (diagonalEvolution_mem_diagonalDomain_iff a t).2 hx⟩)
  have hv (i : ι) : v i = -(I * (a i * phase (a i) t)) * x i := by
    change -(I * (a i * (phase (a i) t * x i))) = _
    ring
  set w : ℝ → ℓ²(ι, ℂ) := fun h =>
    h⁻¹ • (diagonalEvolution a (t + h) x - diagonalEvolution a t x) - v
  have hw (h : ℝ) (i : ι) :
      w h i = h⁻¹ • (phase (a i) (t + h) * x i - phase (a i) t * x i) - v i :=
    rfl
  rw [hasDerivAt_iff_tendsto_slope_zero, tendsto_iff_norm_sub_tendsto_zero]
  change Tendsto (fun h => ‖w h‖) _ _
  have hsum : Summable fun i => 4 * ‖(a i : ℂ) * x i‖ ^ 2 :=
    ((memℓp_gen_iff (p := 2) (by norm_num)).1 hx).mul_left 4 |>.congr fun i => by simp
  have hsq : Tendsto (fun h => ‖w h‖ ^ 2) (𝓝[≠] 0) (𝓝 0) := by
    simp only [norm_sq_eq_tsum]
    have key : Tendsto (fun h => ∑' i, ‖w h i‖ ^ 2) (𝓝[≠] 0) (𝓝 (∑' _ : ι, (0 : ℝ))) := by
      refine tendsto_tsum_of_dominated_convergence hsum (fun i => ?_) ?_
      · -- Each coordinate converges, since `s ↦ e^{-i a i s} x i` is differentiable.
        have hd := hasDerivAt_iff_tendsto_slope_zero.1 ((hasDerivAt_phase (a i) t).mul_const (x i))
        have h0 := (tendsto_sub_nhds_zero_iff.2 hd).norm.pow 2
        refine (h0.congr fun h => ?_).trans (le_of_eq (by simp))
        rw [hw, hv]
      · filter_upwards [self_mem_nhdsWithin] with h (hh : h ≠ 0) i
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), hw, hv, phase_add]
        have he : h⁻¹ • (phase (a i) t * phase (a i) h * x i - phase (a i) t * x i) -
            -(I * (a i * phase (a i) t)) * x i =
            phase (a i) t * x i * (h⁻¹ • (phase (a i) h - 1) + I * a i) := by
          simp only [real_smul]
          ring
        have hb : ‖h⁻¹ • (phase (a i) h - 1)‖ ≤ |a i| := by
          rw [norm_smul, Real.norm_eq_abs, abs_inv]
          calc |h|⁻¹ * ‖phase (a i) h - 1‖ ≤ |h|⁻¹ * (|a i| * |h|) :=
                mul_le_mul_of_nonneg_left (norm_phase_sub_one_le _ _) (by positivity)
            _ = |a i| := by field_simp [abs_ne_zero.2 hh]
        have hn : ‖h⁻¹ • (phase (a i) h - 1) + I * a i‖ ≤ 2 * |a i| := by
          refine (norm_add_le _ _).trans ?_
          rw [norm_mul, norm_I, one_mul, norm_real, Real.norm_eq_abs]
          linarith
        rw [he, norm_mul, norm_mul, norm_phase, one_mul, norm_mul, norm_real, Real.norm_eq_abs]
        calc (‖x i‖ * ‖h⁻¹ • (phase (a i) h - 1) + I * a i‖) ^ 2 ≤ (‖x i‖ * (2 * |a i|)) ^ 2 :=
              pow_le_pow_left₀ (by positivity) (mul_le_mul_of_nonneg_left hn (norm_nonneg _)) 2
          _ = 4 * (|a i| * ‖x i‖) ^ 2 := by ring
    rwa [tsum_zero] at key
  have := hsq.sqrt
  rw [Real.sqrt_zero] at this
  exact this.congr fun h => Real.sqrt_sq (norm_nonneg _)

/-- Off the domain of `A = lp.diagonal a`, the orbit `t ↦ U t x` is differentiable nowhere: a
derivative `y` would have coordinates `y i = -i a i (U t x) i`, and `y ∈ ℓ²` would put `x` in the
domain. -/
theorem not_differentiableAt_diagonalEvolution {x : ℓ²(ι, ℂ)} (hx : x ∉ diagonalDomain a)
    (t : ℝ) : ¬ DifferentiableAt ℝ (fun s => diagonalEvolution a s x) t := by
  intro hd
  apply hx
  set y := deriv (fun s => diagonalEvolution a s x) t
  have hy (i : ι) : y i = -(I * (a i * phase (a i) t)) * x i := by
    have h1 := (evalCLM (𝕜 := ℝ) (E := fun _ : ι => ℂ) (p := 2) i).hasFDerivAt.comp_hasDerivAt t
      hd.hasDerivAt
    exact h1.unique ((hasDerivAt_phase (a i) t).mul_const (x i))
  rw [mem_diagonalDomain, memℓp_congr_norm (g := y) fun i => ?_]
  · exact y.2
  rw [hy]
  simp [norm_phase]

/-- The Schrödinger equation for `A = lp.diagonal a` holds along the orbit of `x` exactly when
`x` lies in the domain of `A`. -/
theorem differentiableAt_diagonalEvolution_iff {x : ℓ²(ι, ℂ)} (t : ℝ) :
    DifferentiableAt ℝ (fun s => diagonalEvolution a s x) t ↔ x ∈ diagonalDomain a :=
  ⟨fun hd => by_contra fun hx => not_differentiableAt_diagonalEvolution a hx t hd,
    fun hx => (hasDerivAt_diagonalEvolution a hx t).differentiableAt⟩

end lp
